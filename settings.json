{
  "editor.accessibilitySupport": "off",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.s3db": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "tsconfig.json": "tsconfig.*.json",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "material-icon-theme.activeIconPack": "nest",
  "prisma.showPrismaDataPlatformNotification": false,
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "window.customTitleBarVisibility": "auto",
  "workbench.colorTheme": "GitHub Dark",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "database-client.autoSync": true,
  "workbench.productIconTheme": "a-file-icon-vscode-product-icon-theme",
  "workbench.iconTheme": "material-icon-theme",
  "files.autoSave": "onFocusChange",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "git.autofetch": true,
  "chat.disableAIFeatures": true,
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "copilot": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },
  "workbench.settings.showAISearchToggle": false,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": {
    "*": false,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "terminal.integrated.initialHint": false,
  "gitlens.ai.enabled": false,
  "python.analysis.aiCodeActions": {
    "implementAbstractClasses": false,
  },
  "telemetry.telemetryLevel": "off",
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-collections-post-response.instructions.md": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-collections-pre-request.instructions.md": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-folder-post-response.instructions.md": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-folder-pre-request.instructions.md": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-http-request-post-response.instructions.md": true,
    "/var/folders/3v/ckt1bg8j2t19c2jxb26vyppr0000gn/T/postman-http-request-pre-request.instructions.md": true,
  },
  "extensions.allowed": {
    "*": true,
    "anthropic.claude-code": false,
    "github.copilot": false,
    "github.copilot-chat": false,
    "amazonwebservices.amazon-q-vscode": false,
    "codeium.codeium": false,
    "tabnine.tabnine-vscode": false,
    "continue.continue": false,
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "eslint.useFlatConfig": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "debug.javascript.autoAttachFilter": "smart",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit",
    },
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.activateEnvironment": true,
  "jupyter.askForKernelRestart": false,
  "mdb.sendTelemetry": false,
  "mdb.showOverviewPageAfterInstall": false,
  "mdb.confirmRunAll": true,
  "chat.mcp.access": "none",

  // ── Terminal integrada: igual que Ghostty + Starship "Neon Dev" ──
  "terminal.integrated.fontFamily": "monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.lineHeight": 1.25,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.customGlyphs": true,
  "terminal.integrated.minimumContrastRatio": 3,
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyleInactive": "outline",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.enabled": true,
  // ── Editor: misma fuente que la terminal ──
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.renderLineHighlight": "all",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.renderCharacters": false,
  "workbench.list.smoothScrolling": true,
  "debug.console.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",

  // ── Tema "Outatime": inspirado en Volver al futuro, sobre GitHub Dark ──
  // Acero del DeLorean · logo naranja/amarillo · condensador de flujo azul · relojes LED rojo/verde/ámbar
  "workbench.colorCustomizations": {
    "[GitHub Dark]": {
      // Base
      "foreground": "#e4dfd3",
      "focusBorder": "#ff7a2f",
      "selection.background": "#6fd3ff44",
      "widget.shadow": "#00000080",
      "icon.foreground": "#a9a49a",
      "textLink.foreground": "#6fd3ff",
      "textLink.activeForeground": "#ffc93c",
      "badge.background": "#ff7a2f",
      "badge.foreground": "#0b0b0c",
      "progressBar.background": "#6fd3ff",
      "scrollbarSlider.background": "#ffffff12",
      "scrollbarSlider.hoverBackground": "#ffffff20",
      "scrollbarSlider.activeBackground": "#ff7a2f66",

      // Barra de título, actividad y lateral
      "titleBar.activeBackground": "#101113",
      "titleBar.activeForeground": "#e4dfd3",
      "titleBar.inactiveBackground": "#101113",
      "titleBar.inactiveForeground": "#6b7078",
      "titleBar.border": "#26292d",
      "commandCenter.background": "#1c1e21",
      "commandCenter.foreground": "#ffb000",
      "commandCenter.border": "#33373c",
      "commandCenter.activeBorder": "#ff7a2f",
      "activityBar.background": "#101113",
      "activityBar.foreground": "#ffc93c",
      "activityBar.inactiveForeground": "#6b7078",
      "activityBar.activeBorder": "#ff7a2f",
      "activityBar.border": "#26292d",
      "activityBarBadge.background": "#ff7a2f",
      "activityBarBadge.foreground": "#0b0b0c",
      "sideBar.background": "#121315",
      "sideBar.foreground": "#a9a49a",
      "sideBar.border": "#26292d",
      "sideBarTitle.foreground": "#ffc93c",
      "sideBarSectionHeader.background": "#121315",
      "sideBarSectionHeader.foreground": "#ff7a2f",
      "sideBarSectionHeader.border": "#26292d",

      // Listas / árbol de archivos
      "list.activeSelectionBackground": "#ff7a2f26",
      "list.activeSelectionForeground": "#e4dfd3",
      "list.inactiveSelectionBackground": "#ffffff0d",
      "list.hoverBackground": "#ffffff0a",
      "list.focusOutline": "#ff7a2f66",
      "list.highlightForeground": "#ffc93c",
      "tree.indentGuidesStroke": "#33373c",

      // Pestañas
      "editorGroupHeader.tabsBackground": "#101113",
      "editorGroupHeader.tabsBorder": "#26292d",
      "editorGroup.border": "#26292d",
      "tab.activeBackground": "#141517",
      "tab.activeForeground": "#ffc93c",
      "tab.activeBorderTop": "#ff7a2f",
      "tab.activeBorder": "#141517",
      "tab.inactiveBackground": "#101113",
      "tab.inactiveForeground": "#6b7078",
      "tab.hoverBackground": "#1c1e21",
      "tab.border": "#26292d",
      "tab.unfocusedActiveBorderTop": "#3d4147",
      "breadcrumb.background": "#141517",
      "breadcrumb.foreground": "#6b7078",
      "breadcrumb.focusForeground": "#e4dfd3",

      // Editor
      "editor.background": "#141517",
      "editor.foreground": "#e4dfd3",
      "editorCursor.foreground": "#6fd3ff",
      "editor.lineHighlightBackground": "#ffffff07",
      "editor.lineHighlightBorder": "#00000000",
      "editor.selectionBackground": "#6fd3ff33",
      "editor.inactiveSelectionBackground": "#6fd3ff1a",
      "editor.selectionHighlightBackground": "#6fd3ff1a",
      "editor.wordHighlightBackground": "#ffffff12",
      "editor.wordHighlightStrongBackground": "#ffc93c1f",
      "editor.findMatchBackground": "#ff7a2f55",
      "editor.findMatchHighlightBackground": "#ff7a2f22",
      "editorLineNumber.foreground": "#3d4147",
      "editorLineNumber.activeForeground": "#ffb000",
      "editorIndentGuide.background1": "#22252a",
      "editorIndentGuide.activeBackground1": "#3d4147",
      "editorWhitespace.foreground": "#33373c",
      "editorRuler.foreground": "#22252a",
      "editorBracketMatch.background": "#6fd3ff1a",
      "editorBracketMatch.border": "#6fd3ff88",
      "editorBracketHighlight.foreground1": "#ffc93c",
      "editorBracketHighlight.foreground2": "#ff7a2f",
      "editorBracketHighlight.foreground3": "#6fd3ff",
      "editorBracketHighlight.foreground4": "#5ee36a",
      "editorBracketHighlight.foreground5": "#ff4b3e",
      "editorBracketHighlight.foreground6": "#a8c7e0",
      "editorGutter.addedBackground": "#5ee36a",
      "editorGutter.modifiedBackground": "#ffb000",
      "editorGutter.deletedBackground": "#ff4b3e",
      "editorError.foreground": "#ff4b3e",
      "editorWarning.foreground": "#ffb000",
      "editorInfo.foreground": "#6fd3ff",
      "editorWidget.background": "#1c1e21",
      "editorWidget.border": "#33373c",
      "editorSuggestWidget.background": "#1c1e21",
      "editorSuggestWidget.border": "#33373c",
      "editorSuggestWidget.selectedBackground": "#ff7a2f26",
      "editorSuggestWidget.highlightForeground": "#ffc93c",
      "editorHoverWidget.background": "#1c1e21",
      "editorHoverWidget.border": "#33373c",
      "minimap.background": "#141517",
      "minimapSlider.background": "#ffffff0d",

      // Inputs, botones, menús
      "input.background": "#101113",
      "input.border": "#33373c",
      "input.foreground": "#e4dfd3",
      "input.placeholderForeground": "#6b7078",
      "inputOption.activeBorder": "#ff7a2f",
      "dropdown.background": "#1c1e21",
      "dropdown.border": "#33373c",
      "button.background": "#ff7a2f",
      "button.foreground": "#0b0b0c",
      "button.hoverBackground": "#ffc93c",
      "button.secondaryBackground": "#33373c",
      "button.secondaryForeground": "#e4dfd3",
      "quickInput.background": "#1c1e21",
      "quickInputList.focusBackground": "#ff7a2f26",
      "pickerGroup.foreground": "#ffc93c",
      "pickerGroup.border": "#33373c",
      "menu.background": "#1c1e21",
      "menu.selectionBackground": "#ff7a2f26",
      "menu.border": "#33373c",
      "notifications.background": "#1c1e21",
      "notifications.border": "#33373c",
      "notificationCenterHeader.background": "#101113",

      // Barra de estado: los relojes del DeLorean (fondo negro, LED ámbar)
      "statusBar.background": "#0b0b0c",
      "statusBar.foreground": "#ffb000",
      "statusBar.border": "#26292d",
      "statusBar.noFolderBackground": "#0b0b0c",
      "statusBar.noFolderForeground": "#5ee36a",
      "statusBar.debuggingBackground": "#ff4b3e",
      "statusBar.debuggingForeground": "#0b0b0c",
      "statusBarItem.remoteBackground": "#ff7a2f",
      "statusBarItem.remoteForeground": "#0b0b0c",
