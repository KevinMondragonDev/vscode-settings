      "statusBarItem.warningBackground": "#ffb000",
      "statusBarItem.warningForeground": "#0b0b0c",

      // Panel inferior
      "panel.background": "#101113",
      "panel.border": "#26292d",
      "panelTitle.activeForeground": "#ffc93c",
      "panelTitle.activeBorder": "#ff7a2f",
      "panelTitle.inactiveForeground": "#6b7078",

      // Git
      "gitDecoration.addedResourceForeground": "#5ee36a",
      "gitDecoration.untrackedResourceForeground": "#5ee36a",
      "gitDecoration.modifiedResourceForeground": "#ffb000",
      "gitDecoration.deletedResourceForeground": "#ff4b3e",
      "gitDecoration.conflictingResourceForeground": "#ff7a2f",
      "gitDecoration.ignoredResourceForeground": "#3d4147",

      // Terminal integrada
      "terminal.background": "#101113",
      "terminal.foreground": "#ece7dc",
      "terminalCursor.foreground": "#6fd3ff",
      "terminal.selectionBackground": "#6fd3ff44",
      "terminal.border": "#26292d",
      "terminal.ansiBlack": "#1c1e21",
      "terminal.ansiRed": "#ff4b3e",
      "terminal.ansiGreen": "#5ee36a",
      "terminal.ansiYellow": "#ffc93c",
      "terminal.ansiBlue": "#4f9dff",
      "terminal.ansiMagenta": "#ff6f91",
      "terminal.ansiCyan": "#6fd3ff",
      "terminal.ansiWhite": "#e4dfd3",
      "terminal.ansiBrightBlack": "#858b94",
      "terminal.ansiBrightRed": "#ff7a6e",
      "terminal.ansiBrightGreen": "#8ef097",
      "terminal.ansiBrightYellow": "#ffdb7a",
      "terminal.ansiBrightBlue": "#86bcff",
      "terminal.ansiBrightMagenta": "#ff9bb3",
      "terminal.ansiBrightCyan": "#a3e4ff",
      "terminal.ansiBrightWhite": "#f7f3ea",
    },
  },

  // ── Colores de sintaxis "Outatime" ──
  "editor.tokenColorCustomizations": {
    "[GitHub Dark]": {
      "comments": "#6b7078",
      "textMateRules": [
        {
          "scope": ["comment", "punctuation.definition.comment"],
          "settings": { "foreground": "#6b7078", "fontStyle": "italic" },
        },
        {
          "scope": [
            "keyword",
            "storage.type",
            "storage.modifier",
            "keyword.control",
          ],
          "settings": { "foreground": "#ff7a2f" },
        },
        {
          "scope": ["keyword.operator"],
          "settings": { "foreground": "#a9a49a" },
        },
        {
          "scope": ["string", "string.quoted"],
          "settings": { "foreground": "#ffc93c" },
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language",
            "constant.character",
          ],
          "settings": { "foreground": "#ff4b3e" },
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call",
          ],
          "settings": { "foreground": "#6fd3ff" },
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.class",
            "support.type",
          ],
          "settings": { "foreground": "#5ee36a" },
        },
        {
          "scope": ["variable", "meta.definition.variable"],
          "settings": { "foreground": "#e4dfd3" },
        },
        {
          "scope": ["variable.parameter"],
          "settings": { "foreground": "#ffd9a0", "fontStyle": "italic" },
        },
        {
          "scope": [
            "variable.language",
            "variable.language.this",
            "variable.language.self",
          ],
          "settings": { "foreground": "#ff7a2f", "fontStyle": "italic" },
        },
        {
          "scope": ["entity.name.tag"],
          "settings": { "foreground": "#ff7a2f" },
        },
        {
          "scope": ["entity.other.attribute-name"],
          "settings": { "foreground": "#6fd3ff", "fontStyle": "italic" },
        },
        {
          "scope": ["support.type.property-name", "meta.object-literal.key"],
          "settings": { "foreground": "#a8c7e0" },
        },
        {
          "scope": ["entity.name.function.decorator", "meta.decorator"],
          "settings": { "foreground": "#5ee36a", "fontStyle": "italic" },
        },
        { "scope": ["punctuation"], "settings": { "foreground": "#8a8f96" } },
      ],
    },
  },
  "editor.semanticTokenColorCustomizations": {
    "[GitHub Dark]": {
      "rules": {
        "function": "#6fd3ff",
        "method": "#6fd3ff",
        "class": "#5ee36a",
        "type": "#5ee36a",
        "interface": "#5ee36a",
        "parameter": { "foreground": "#ffd9a0", "italic": true },
        "property": "#a8c7e0",
        "variable": "#e4dfd3",
        "variable.readonly": "#ff4b3e",
        "selfParameter": { "foreground": "#ff7a2f", "italic": true },
        "decorator": { "foreground": "#5ee36a", "italic": true },
        "namespace": "#ffb000",
      },
    },
  },
}
